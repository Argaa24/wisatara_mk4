<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forest_green_dark"
    android:padding="24dp"
    tools:context=".SplashActivity">

    <!-- Top Badge -->
    <TextView
        android:id="@+id/tvTopBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_pill_dark_green"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="IDN 100% LOKAL"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Center Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_circle_green"
            android:padding="16dp"
            android:src="@drawable/ic_compass"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Wisatara"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.2"
            android:text="JELAJAH NUSANTARA"
            android:textColor="@color/mint_accent_light"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="Marketplace Pemandu Wisata Lokal &amp; 100% Private Tour Nusantara"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />

        <!-- Region Pills -->
        <TextView
            android:id="@+id/tvRegions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_pill_dark_green"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Sumatra • Jawa • Bali • Komodo • Papua"
            android:textColor="#E0FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Bottom Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMulai"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/emerald_primary"
            android:text="Mulai Petualangan  →"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp" />

        <TextView
            android:id="@+id/tvFooterVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="v1.0.0 • Jelajahi Indonesia Bersama Pemandu Lokal"
            android:textColor="#80FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>

</RelativeLayout>